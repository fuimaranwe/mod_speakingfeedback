<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/speakingfeedback/db" VERSION="20261016" COMMENT="Speaking practice and feedback">
  <TABLES>
    <TABLE NAME="speakingfeedback" COMMENT="Activity configuration">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="instructions" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="instructionsformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="feedbackprompt" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="preparationtime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="30"/>
        <FIELD NAME="recordingtime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="120"/>
        <FIELD NAME="maxattempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completionfeedback" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/></KEYS>
    </TABLE>
    <TABLE NAME="speakingfeedback_keys" COMMENT="Encrypted activity credentials excluded from backups">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="speakingfeedbackid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="secret" TYPE="text" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="activity" TYPE="foreign-unique" FIELDS="speakingfeedbackid" REFTABLE="speakingfeedback" REFFIELDS="id"/></KEYS>
    </TABLE>
    <TABLE NAME="speakingfeedback_attempts" COMMENT="Submitted and draft attempts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="speakingfeedbackid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="token" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft"/>
        <FIELD NAME="instructions" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="feedbackprompt" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="preparationtime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="recordingtime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="transcript" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="feedback" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="errorcode" TYPE="char" LENGTH="40" NOTNULL="true"/>
        <FIELD NAME="retryafter" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="activity" TYPE="foreign" FIELDS="speakingfeedbackid" REFTABLE="speakingfeedback" REFFIELDS="id"/><KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="submissiontoken" UNIQUE="true" FIELDS="speakingfeedbackid, userid, token"/><INDEX NAME="history" UNIQUE="false" FIELDS="speakingfeedbackid, userid, timesubmitted"/><INDEX NAME="cleanup" UNIQUE="false" FIELDS="status, timemodified"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
